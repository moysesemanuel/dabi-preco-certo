{
  "name": "dabi-preco-certo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build && node scripts/generate-headers.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "worker:migrate": "node worker/scripts/d1.ts migrate --env local",
    "d1": "node worker/scripts/d1.ts",
    "worker:dev": "wrangler dev --local --config worker/wrangler.toml",
    "licenses": "node worker/scripts/licenses.ts",
    "typecheck": "tsc -b",
    "audit": "npm audit --audit-level=high",
    "check:secrets": "sh scripts/check-secrets.sh"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@tailwindcss/vite": "^4.1.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.1.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.9",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "fake-indexeddb": "^6.2.8",
    "jsdom": "^29.1.1",
    "typescript": "^5.7.3",
    "vite": "^6.0.5",
    "vitest": "^4.1.12",
    "wrangler": "^4.160.1"
  },
  "engines": {
    "node": ">=22.18"
  }
}
