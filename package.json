    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "fake-indexeddb": "^6.2.8",
    "jsdom": "^29.1.1",
    "typescript": "^5.7.3",
    "vite": "^6.0.5",
    "vitest": "^4.1.12",
    "wrangler": "^4.160.1"
